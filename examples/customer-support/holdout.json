        {"id": "lookup_order", "tool": "lookup_order", "params": {"order_id": "O-102", "customer_id": "C-102"}, "output": {"order_id": "O-102", "customer_id": "C-102", "status": "delivered", "delivered": true, "damaged": true, "duplicate_charge": false}, "depends_on": ["lookup_customer"], "status": "completed", "side_effects": [{"kind": "read", "target": "mock.orders"}]},
